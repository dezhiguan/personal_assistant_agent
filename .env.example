# 复制为 .env，仅在服务端填写真实配置。请勿提交 .env。
MODEL_NAME=qwen-plus
DASHSCOPE_API_KEY=
# 北京地域。其他地域或专属业务空间请填写对应百炼地址，密钥须与地域一致。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_TIMEOUT_SECONDS=90

# 仅允许项目工作目录内非隐藏的相对子目录；不是宿主机任意绝对路径。
# 虚拟 / 映射到该目录；所有本机会话和子代理共享文件，请勿存放密钥。
ASSISTANT_WORKSPACE_DIR=workspace
# 百度搜索由服务端发起 HTTPS，无需搜索 API Key；失败不会改用其他引擎。
BAIDU_TIMEOUT_SECONDS=10
# 可选显式 HTTP(S) 代理；留空直连，不读取系统 HTTP_PROXY/HTTPS_PROXY。
BAIDU_HTTP_PROXY=

# 其他外部服务单次请求超时，最大 60 秒；不使用系统代理。
TOOL_TIMEOUT_SECONDS=15
# 高德地图 Web服务类型 Key（不是 JS API 类型 Key），仅配置在服务端。
AMAP_API_KEY=
# 和风天气新版预警接口。Host 只填写控制台分配的主机名，不带 https://。
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 旅行供应商：tuniu 使用大陆途牛 MCP；amadeus 保留原有接入。
TRAVEL_PROVIDER=tuniu
TUNIU_API_KEY=
# 仅接受官方 /mcp 或 /hybrid/mcp 地址，Key 在 HTTP Header 中传递。
TUNIU_MCP_BASE_URL=https://openapi.tuniu.cn/mcp
# 旅行接口：test 为沙箱数据；production 需供应商授予真实预订权限。
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
# 项目内、工作区外的私有目录，不能用绝对路径或符号链接。
# 凭据/旅客与付款资料放 profiles/<name>.json，目录 0700，文件 0600。
TRAVEL_PRIVATE_DIR=.assistant-private

# 开启后，模型调用的输入与输出会发送到你的 LangSmith 项目。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-assistant-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 运行 scripts/sync_prompt.py 后填写提交哈希；留空使用打包的本地提示词。
LANGSMITH_PROMPT_REF=
