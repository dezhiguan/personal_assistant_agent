# 复制为 .env，仅在服务端填写真实配置。请勿提交 .env。
MODEL_NAME=qwen-plus
DASHSCOPE_API_KEY=
# 北京地域。其他地域或专属业务空间请填写对应百炼地址，密钥须与地域一致。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_TIMEOUT_SECONDS=90

# 仅允许项目工作目录内非隐藏的相对子目录；不是宿主机任意绝对路径。
# 虚拟 / 映射到该目录；所有本机会话和子代理共享文件，请勿存放密钥。
ASSISTANT_WORKSPACE_DIR=workspace
# 百度搜索由服务端发起 HTTPS，无需搜索 API Key；失败不会改用其他引擎。
BAIDU_TIMEOUT_SECONDS=10
# 可选显式 HTTP(S) 代理；留空直连，不读取系统 HTTP_PROXY/HTTPS_PROXY。
BAIDU_HTTP_PROXY=

# 开启后，模型调用的输入与输出会发送到你的 LangSmith 项目。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-assistant-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 运行 scripts/sync_prompt.py 后填写提交哈希；留空使用打包的本地提示词。
LANGSMITH_PROMPT_REF=
